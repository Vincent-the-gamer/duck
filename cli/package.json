{
  "name": "@vince-gamer/duck-cli",
  "version": "1.0.2",
  "type": "module",
  "description": "CLI tools for duck image encode/decode",
  "files": [
    "bin",
    "dist"
  ],
  "main": "src/index.ts",
  "bin": {
    "duck": "bin/duck-cli.js"
  },
  "scripts": {
    "tsx": "tsx",
    "build": "tsdown"
  },
  "keywords": [
    "cli"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com",
    "access": "public"
  },
  "author": "Vincent-the-gamer",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "cac": "^6.7.14",
    "decoder": "workspace:*",
    "encoder": "workspace:*",
    "restore-cursor": "^5.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "tsx": "^4.22.3"
  }
}
